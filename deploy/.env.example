# Копія цього файлу на сервері: deploy/.env (chmod 600). У git він не потрапляє.
# Значення без лапок і пробілів. Паролі генеруйте командою: openssl rand -hex 24

# Домен, який вказує на IP сервера (без https://)
DOMAIN=api.example.com

POSTGRES_PASSWORD=змініть-мене
REDIS_PASSWORD=змініть-мене

# openssl rand -hex 32
JWT_SECRET=змініть-мене

# Пошти адмінів через кому: отримують роль ADMIN при вході
ADMIN_EMAILS=
# Вхід через Microsoft Entra. Порожньо = POST /auth/microsoft відповідає 503, доки тенант не зареєстровано
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
ALLOWED_EMAIL_DOMAIN=lnu.edu.ua
# Origin веб-адмінки через кому (без слеша в кінці). Порожньо = CORS вимкнений
CORS_ORIGINS=
# Гостьовий режим: розклад, групи й аудиторії без входу (/public/*). off = вимкнути (404), якщо університет проти
PUBLIC_API=on
# Ліміт запитів до /public/* з одного IP за хвилину
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Моніторинг (необов'язково, але рекомендовано). URL перевірок з healthchecks.io або схожого сервісу:
# сервіс сповіщає, коли ping перестають надходити. Див. docs/deploy-vps.md, розділи 6 і 8.
BACKUP_PING_URL=
CHECK_PING_URL=

# Не задавайте тут NODE_ENV=test і AUTH_MODE=fake: це вмикає фейковий вхід і /dev
