# Caddy сам отримує і поновлює HTTPS-сертифікат Let's Encrypt для домену з DOMAIN.
# Для цього домен має вказувати A-записом на IP сервера, а порти 80 і 443 мають бути відкриті.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Access-лог у JSON (stdout контейнера, ротується разом з іншими логами). Authorization і Cookie Caddy
	# за замовчуванням редагує, тож токени в лог не потрапляють. request_id збігається з reqId у логах API.
	log {
		format json
	}
	log_append request_id {http.request.uuid}

	reverse_proxy api:3000 {
		# Наскрізний id запиту: API використовує його як reqId, тож записи Caddy і Fastify зіставляються
		header_up X-Request-ID {http.request.uuid}
	}
}
