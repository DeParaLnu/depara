{
  "name": "depara-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "prisma migrate deploy && tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed/seed.ts",
    "seed:demo": "tsx prisma/seed/demo.ts",
    "start:test": "tsx src/server.ts",
    "test:e2e": "start-server-and-test start:test http://localhost:3000/health \"vitest run\""
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prisma": "^6.0.0",
    "start-server-and-test": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
