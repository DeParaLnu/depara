# Postgres. Локально це docker-контейнер, на проді рядки з Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/depara
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/depara

# Обов'язковий на сервері. Згенеруйте випадковий рядок: openssl rand -hex 32
JWT_SECRET=change-me-locally
PORT=3000

# Redis: кеш розкладу, refresh-сесії, черга BullMQ (використовується з наступних кроків).
REDIS_URL=redis://localhost:6379

# Вхід через Microsoft Entra (F1). Поки тенант не зареєстровано, лишіть порожніми: POST /auth/microsoft
# відповідатиме 503 AUTH_NOT_CONFIGURED. Це не секрети (ідентифікатори), але залежать від реєстрації застосунку.
# MICROSOFT_CLIENT_ID: Application (client) ID, він же aud у ID-токені.
# MICROSOFT_TENANT_ID: Directory (tenant) ID організації, з якої пускаємо (tid у токені).
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
# Домен пошти, який пускаємо (за замовчуванням lnu.edu.ua)
# ALLOWED_EMAIL_DOMAIN=lnu.edu.ua

# Origin веб-адмінки через кому (без слеша в кінці), напр. https://admin.example.com. Порожньо = CORS вимкнений.
# CORS_ORIGINS=http://localhost:5173

# Гостьовий режим (/public/*): PUBLIC_API=off вимикає (404). Ліміт запитів з одного IP за хвилину.
# PUBLIC_API=on
# PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Пошти (через кому), які отримують роль ADMIN при вході. Так з'являється перший адмін.
# ADMIN_EMAILS=you@lnu.edu.ua

# Тільки для E2E (разом з NODE_ENV=test). У проді НЕ задавати.
# AUTH_MODE=fake
# Для E2E сценаріїв CORS (F7) додатково: CORS_ORIGINS=http://localhost:5173
