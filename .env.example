# Postgres. Локально це docker-контейнер, на проді рядки з Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/depara
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/depara

# Обов'язковий на сервері. Згенеруйте випадковий рядок: openssl rand -hex 32
JWT_SECRET=change-me-locally
PORT=3000

# Redis: кеш розкладу, refresh-сесії, черга BullMQ (використовується з наступних кроків).
REDIS_URL=redis://localhost:6379

# Web client ID з Google Cloud Console (aud у idToken). Потрібен для справжнього входу (F1).
# Це не секрет: він і так зашитий у мобільний застосунок, тому лежить у репозиторії.
GOOGLE_CLIENT_ID=606725021124-78ncavdbk7ak4pphjhd7lfrnjiahhkec.apps.googleusercontent.com

# Пошти (через кому), які отримують роль ADMIN при вході. Так з'являється перший адмін.
# ADMIN_EMAILS=you@lnu.edu.ua

# Тільки для E2E (разом з NODE_ENV=test). У проді НЕ задавати.
# AUTH_MODE=fake
