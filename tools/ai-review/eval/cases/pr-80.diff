+import { Ionicons } from '@expo/vector-icons';
+import { ActivityIndicator, FlatList, Modal, Pressable, StyleSheet, Text, TextInput, View } from 'react-native';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+import { colors, errorText } from '../../theme';
+
+export type PickerItem = { key: string; title: string; subtitle?: string };
+
+type Props = {
+  visible: boolean;
+  title: string;
+  items: PickerItem[];
+  selectedKey?: string | null;
+  onSelect: (key: string) => void;
+  onClose: () => void;
+  testID: string;
+  /** Пошук: якщо задано, зверху поле вводу */
+  search?: { value: string; onChange: (q: string) => void; placeholder: string };
+  loading?: boolean;
+  errorCode?: string | null;
+  emptyText?: string;
+};
+
+// Нижній лист вибору (пара, викладач, аудиторія) для форми «Нова заміна»
+export function PickerSheet({
+  visible,
+  title,
+  items,
+  selectedKey,
+  onSelect,
+  onClose,
+  testID,
+  search,
+  loading,
+  errorCode,
+  emptyText = 'Нічого не знайдено',
+}: Props) {
+  const insets = useSafeAreaInsets();
+  return (
+    <Modal visible={visible} transparent animationType="slide" onRequestClose={onClose} statusBarTranslucent>
+      <View style={styles.root}>
+        <Pressable
+          style={StyleSheet.absoluteFill}
+          onPress={onClose}
+          accessibilityRole="button"
+          accessibilityLabel="Закрити вибір"
+        />
+        <View style={[styles.sheet, { paddingBottom: insets.bottom + 12 }]} testID={testID}>
+          <View style={styles.handle} />
+          <Text style={styles.title} accessibilityRole="header">
+            {title}
+          </Text>
+          {search ? (
+            <TextInput
+              testID={`${testID}-search`}
+              value={search.value}
+              onChangeText={search.onChange}
+              placeholder={search.placeholder}
+              placeholderTextColor={colors.textMuted}
+              style={styles.search}
+              autoCorrect={false}
+              autoFocus
+            />
+          ) : null}
+          {loading ? (
+            <ActivityIndicator style={styles.state} color={colors.primary} accessibilityLabel="Завантаження" />
+          ) : errorCode ? (
+            <Text style={[styles.state, styles.error]}>{errorText(errorCode)}</Text>
+          ) : (
+            <FlatList
+              data={items}
+              keyExtractor={(item) => item.key}
+              keyboardShouldPersistTaps="handled"
+              style={styles.list}
+              ListEmptyComponent={<Text style={[styles.state, styles.empty]}>{emptyText}</Text>}
+              renderItem={({ item }) => {
+                const selected = item.key === selectedKey;
+                return (
+                  <Pressable
+                    testID={`${testID}-item-${item.key}`}
+                    accessibilityRole="button"
+                    accessibilityState={{ selected }}
+                    accessibilityLabel={item.subtitle ? `${item.title}, ${item.subtitle}` : item.title}
+                    onPress={() => onSelect(item.key)}
+                    style={({ pressed }) => [styles.item, pressed && styles.itemPressed]}
+                  >
+                    <View style={styles.itemText}>
+                      <Text style={styles.itemTitle}>{item.title}</Text>
+                      {item.subtitle ? <Text style={styles.itemSubtitle}>{item.subtitle}</Text> : null}
+                    </View>
+                    {selected ? <Ionicons name="checkmark" size={22} color={colors.primary} /> : null}
+                  </Pressable>
+                );
+              }}
+            />
+          )}
+        </View>
+      </View>
+    </Modal>
+  );
+}
+
+const styles = StyleSheet.create({
+  root: { flex: 1, justifyContent: 'flex-end', backgroundColor: 'rgba(17,24,39,0.45)' },
+  sheet: {
+    maxHeight: '80%',
+    backgroundColor: colors.surface,
+    borderTopLeftRadius: 28,
+    borderTopRightRadius: 28,
+    paddingHorizontal: 21,
+    paddingTop: 12,
+  },
+  handle: { alignSelf: 'center', width: 44, height: 5, borderRadius: 3, backgroundColor: colors.border, marginBottom: 12 },
+  title: { fontSize: 20, lineHeight: 26, fontWeight: '700', color: colors.text, marginBottom: 12 },
+  search: {
+    height: 48,
+    borderRadius: 14,
+    borderWidth: 1,
+    borderColor: colors.border,
+    paddingHorizontal: 14,
+    fontSize: 16,
+    color: colors.text,
+    marginBottom: 8,
+  },
+  list: { flexGrow: 0 },
+  item: {
+    minHeight: 56,
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: 12,
+    paddingVertical: 10,
+    borderBottomWidth: 1,
+    borderBottomColor: colors.border,
+  },
+  itemPressed: { backgroundColor: colors.chip },
+  itemText: { flex: 1, gap: 2 },
+  itemTitle: { fontSize: 16, lineHeight: 21, fontWeight: '600', color: colors.text },
+  itemSubtitle: { fontSize: 14, lineHeight: 18, color: colors.textMuted },
+  state: { paddingVertical: 24 },
+  error: { color: colors.error, fontSize: 15, textAlign: 'center' },
+  empty: { color: colors.textMuted, fontSize: 15, textAlign: 'center' },
+});
diff --git a/mobile/src/features/substitutions/SubstitutionActions.tsx b/mobile/src/features/substitutions/SubstitutionActions.tsx
new file mode 100644
index 0000000..ad847dc
--- /dev/null
+++ b/mobile/src/features/substitutions/SubstitutionActions.tsx
@@ -0,0 +1,89 @@
+import { router } from 'expo-router';
+import { useState } from 'react';
+import { ActivityIndicator, Alert, Pressable, StyleSheet, Text } from 'react-native';
+import type { Lesson } from '../../api';
+import { reportError } from '../../lib/errors';
+import { colors, errorText } from '../../theme';
+import { useCanManageSubstitutions, useDeleteSubstitution } from './hooks';
+
+type Props = { lesson: Lesson; onClose: () => void };
+
+// Кнопки старости в деталях пари: «Додати заміну» або «Скасувати заміну». Студент їх не бачить
+export function SubstitutionActions({ lesson, onClose }: Props) {
+  const canManage = useCanManageSubstitutions();
+  const remove = useDeleteSubstitution();
+  const [error, setError] = useState<string | null>(null);
+  if (!canManage) return null;
+
+  const sub = lesson.substitution;
+  if (!sub) {
+    return (
+      <Pressable
+        testID="add-substitution-button"
+        accessibilityRole="button"
+        onPress={() => {
+          onClose();
+          router.push({ pathname: '/substitution', params: { date: lesson.date, lessonId: lesson.id } });
+        }}
+        style={({ pressed }) => [styles.button, pressed && styles.pressed]}
+      >
+        <Text style={styles.addText}>Додати заміну</Text>
+      </Pressable>
+    );
+  }
+
+  const cancel = async () => {
+    setError(null);
+    try {
+      await remove.mutateAsync(sub.id);
+      onClose();
+    } catch (e) {
+      setError(errorText(reportError('substitution', e)));
+    }
+  };
+  const confirm = () =>
+    Alert.alert('Скасувати заміну?', 'Пара повернеться до звичайного вигляду в розкладі групи.', [
+      { text: 'Ні', style: 'cancel' },
+      { text: 'Скасувати заміну', style: 'destructive', onPress: () => void cancel() },
+    ]);
+
+  return (
+    <>
+      {error ? (
+        <Text style={styles.error} accessibilityRole="alert">
+          {error}
+        </Text>
+      ) : null}
+      <Pressable
+        testID="cancel-substitution-button"
+        accessibilityRole="button"
+        accessibilityState={{ disabled: remove.isPending, busy: remove.isPending }}
+        disabled={remove.isPending}
+        onPress={confirm}
+        style={({ pressed }) => [styles.button, pressed && styles.pressed]}
+      >
+        {remove.isPending ? (
+          <ActivityIndicator color={colors.danger} />
+        ) : (
+          <Text style={styles.cancelText}>Скасувати заміну</Text>
+        )}
+      </Pressable>
+    </>
+  );
+}
+
+const styles = StyleSheet.create({
+  button: {
+    height: 56,
+    borderRadius: 14,
+    borderWidth: 1,
+    borderColor: colors.border,
+    alignItems: 'center',
+    justifyContent: 'center',
+    marginTop: 12,
+  },
+  pressed: { backgroundColor: colors.chip },
+  addText: { fontSize: 17, fontWeight: '700', color: colors.primary },
+  cancelText: { fontSize: 17, fontWeight: '700', color: colors.danger },
+  error: { color: colors.error, fontSize: 15, lineHeight: 20, marginTop: 12, textAlign: 'center' },
+});
diff --git a/mobile/src/features/substitutions/SubstitutionScreen.tsx b/mobile/src/features/substitutions/SubstitutionScreen.tsx
new file mode 100644
index 0000000..ec0e9f9
--- /dev/null
+++ b/mobile/src/features/substitutions/SubstitutionScreen.tsx
@@ -0,0 +1,495 @@
+import { Ionicons } from '@expo/vector-icons';
+import { useMemo, useState } from 'react';
+import {
+  ActivityIndicator,
+  KeyboardAvoidingView,
+  Platform,
+  Pressable,
+  ScrollView,
+  StyleSheet,
+  Text,
+  TextInput,
+  View,
+} from 'react-native';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+import type { Lesson, SubstitutionKind } from '../../api';
+import { StateView } from '../../components/StateView';
+import { addDays, dayMonth, fromIsoDate, mondayOf, toIsoDate, weekdayShort, weekdayShortCap } from '../../lib/date';
+import { errorCode, reportError } from '../../lib/errors';
+import { colors, errorText } from '../../theme';
+import { useClassrooms, useDebounce } from '../rooms/hooks';
+import { useGroups, useMe, useWeek } from '../schedule/hooks';
+import { lessonTypeLabel } from '../schedule/lesson';
+import {
+  buildSubstitution,
+  emptyForm,
+  KIND_OPTIONS,
+  MAX_COMMENT,
+  PAIR_NUMBERS,
+  selectableLessons,
+  type SubstitutionForm,
+} from './form';
+import { useCanManageSubstitutions, useCreateSubstitution, useTeachers } from './hooks';
+import { PickerSheet, type PickerItem } from './PickerSheet';
+
+type Props = {
+  /** День, з якого відкрили форму (YYYY-MM-DD): з його тижня береться список пар */
+  date: string;
+  /** Пара, для якої відкрили форму з деталей пари */
+  lessonId?: string;
+  onClose: () => void;
+};
+
+type Picker = 'lesson' | 'teacher' | 'classroom' | null;
+
+const lessonSubtitle = (l: Lesson) => {
+  const d = fromIsoDate(l.date);
+  return [`${weekdayShort(d)} ${dayMonth(d)}`, l.start, lessonTypeLabel[l.type], l.subgroup > 0 ? `підгрупа ${l.subgroup}` : null]
+    .filter(Boolean)
+    .join(' · ');
+};
+
+// F6: форма «Нова заміна» (макет docs/design/15-new-substitution.png) і екран «Заміну збережено» (16)
+export function SubstitutionScreen({ date, lessonId, onClose }: Props) {
+  const insets = useSafeAreaInsets();
+  const canManage = useCanManageSubstitutions();
+  const me = useMe();
+  const groups = useGroups();
+  const groupCode = groups.data?.find((g) => g.id === me.data?.groupId)?.code;
+
+  const monday = mondayOf(fromIsoDate(date));
+  const week = useWeek(toIsoDate(monday));
+  const lessons = useMemo(() => selectableLessons(week.data?.lessons ?? []), [week.data]);
+
+  // Пара за замовчуванням: та, з якої відкрили форму, або перша пара обраного дня
+  const [form, setForm] = useState<SubstitutionForm>(() => emptyForm());
+  const [touchedLesson, setTouchedLesson] = useState(false);
+  const defaultLesson = lessons.find((l) => l.id === lessonId) ?? lessons.find((l) => l.date === date) ?? null;
+  const lesson = touchedLesson ? form.lesson : (form.lesson ?? defaultLesson);
+  const current: SubstitutionForm = { ...form, lesson };
+
+  const [picker, setPicker] = useState<Picker>(null);
+  const [teacherQuery, setTeacherQuery] = useState('');
+  const [roomQuery, setRoomQuery] = useState('');
+  const teachers = useTeachers(useDebounce(teacherQuery, 250), picker === 'teacher');
+  const classrooms = useClassrooms(useDebounce(roomQuery, 250), undefined, picker === 'classroom');
+
+  const [formError, setFormError] = useState<string | null>(null);
+  const create = useCreateSubstitution();
+  const [saved, setSaved] = useState(false);
+
+  const update = (patch: Partial<SubstitutionForm>) => {
+    setFormError(null);
+    setForm((f) => ({ ...f, lesson, ...patch }));
+  };
+
+  const submit = async () => {
+    const built = buildSubstitution(current);
+    if (!built.ok) {
+      setFormError(built.error);
+      return;
+    }
+    setFormError(null);
+    try {
+      await create.mutateAsync(built.body);
+      setSaved(true);
+    } catch (e) {
+      setFormError(reportError('substitution', e));
+    }
+  };
+
+  if (!canManage) {
+    return (
+      <View style={[styles.screen, { paddingTop: insets.top + 12 }]}>
+        <Header onBack={onClose} />
+        <StateView
+          icon="lock-closed-outline"
+          title="Недостатньо прав"
+          description="Додавати заміни може лише староста групи."
+          actionLabel="До розкладу"
+          onAction={onClose}
+        />
+      </View>
+    );
+  }
+
+  if (saved) {
+    return (
+      <View style={[styles.screen, styles.savedScreen, { paddingTop: insets.top + 12, paddingBottom: insets.bottom + 24 }]}>
+        <View style={styles.savedBody} testID="substitution-saved">
+          <View style={styles.savedIcon}>
+            <Ionicons name="checkmark" size={64} color="#166534" />
+          </View>
+          <Text style={styles.savedTitle} accessibilityRole="header">
+            Заміну збережено
+          </Text>
+          <Text style={styles.savedSubtitle}>
+            {groupCode ? `Група ${groupCode} побачить її в розкладі` : 'Група побачить її в розкладі'}
+          </Text>
+        </View>
+        <Pressable
+          testID="substitution-done"
+          accessibilityRole="button"
+          onPress={onClose}
+          style={({ pressed }) => [styles.secondary, pressed && styles.secondaryPressed]}
+        >
+          <Text style={styles.secondaryText}>До розкладу</Text>
+        </Pressable>
+      </View>
+    );
+  }
+
+  const kind = current.kind;
+  const moveDays = Array.from({ length: 13 }, (_, i) => addDays(monday, i)).filter((d) => d.getDay() !== 0);
+
+  const lessonItems: PickerItem[] = lessons.map((l) => ({ key: l.id, title: l.subject, subtitle: lessonSubtitle(l) }));
+  const teacherItems: PickerItem[] = (teachers.data ?? []).map((t) => ({
+    key: t.id,
+    title: t.fullName,
+    subtitle: t.position ?? undefined,
+  }));
+  const roomItems: PickerItem[] = (classrooms.data ?? []).map((r) => ({
+    key: r.id,
+    title: `Корпус ${r.building.code} · ${r.number}`,
+    subtitle: r.building.address,
+  }));
+
+  return (
+    <KeyboardAvoidingView style={styles.screen} behavior={Platform.OS === 'ios' ? 'padding' : undefined}>
+      <View style={[styles.flex, { paddingTop: insets.top + 12 }]}>
+        <Header onBack={onClose} />
+        <ScrollView contentContainerStyle={styles.content} keyboardShouldPersistTaps="handled">
+          <Label text="Пара" />
+          {week.isPending ? (
+            <ActivityIndicator color={colors.primary} accessibilityLabel="Завантаження пар" />
+          ) : week.isError && !week.data ? (
+            <Text style={styles.error}>{errorText(errorCode(week.error))}</Text>
+          ) : (
+            <Select
+              testID="substitution-lesson"
+              placeholder={lessons.length ? 'Оберіть пару' : 'Цього тижня немає пар без заміни'}
+              title={lesson?.subject}
+              subtitle={lesson ? lessonSubtitle(lesson) : undefined}
+              onPress={() => setPicker('lesson')}
+              disabled={!lessons.length}
+            />
+          )}
+
+          <Label text="Тип зміни" />
+          <View style={styles.chips}>
+            {KIND_OPTIONS.map((o) => (
+              <Chip
+                key={o.kind}
+                testID={`substitution-kind-${o.kind}`}
+                label={o.label}
+                selected={kind === o.kind}
+                onPress={() => update({ kind: o.kind as SubstitutionKind })}
+              />
+            ))}
+          </View>
+
+          {kind === 'REPLACED' ? (
+            <>
+              <Label text="Новий викладач" />
+              <Select
+                testID="substitution-teacher"
+                placeholder="Оберіть викладача"
+                title={current.teacher?.fullName}
+                onPress={() => setPicker('teacher')}
+              />
+            </>
+          ) : null}
+
+          {kind === 'MOVED' ? (
+            <>
+              <Label text="Нова дата" />
+              <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={styles.dayRow}>
+                {moveDays.map((d) => {
+                  const iso = toIsoDate(d);
+                  return (
+                    <Chip
+                      key={iso}
+                      testID={`substitution-date-${iso}`}
+                      label={`${weekdayShortCap(d)} ${d.getDate()}`}
+                      accessibilityLabel={`${weekdayShort(d)} ${dayMonth(d)}`}
+                      selected={current.newDate === iso}
+                      onPress={() => update({ newDate: current.newDate === iso ? null : iso })}
+                    />
+                  );
+                })}
+              </ScrollView>
+              <Label text="Нова пара" />
+              <View style={styles.chips}>
+                {PAIR_NUMBERS.map((n) => (
+                  <Chip
+                    key={n}
+                    testID={`substitution-pair-${n}`}
+                    label={String(n)}
+                    accessibilityLabel={`${n}-а пара`}
+                    selected={current.newPairNumber === n}
+                    onPress={() => update({ newPairNumber: current.newPairNumber === n ? null : n })}
+                  />
+                ))}
+              </View>
+            </>
+          ) : null}
+
+          {kind === 'ROOM_CHANGED' || kind === 'MOVED' ? (
+            <>
+              <Label text={kind === 'MOVED' ? 'Аудиторія (необовʼязково)' : 'Нова аудиторія'} />
+              <Select
+                testID="substitution-classroom"
+                placeholder="Оберіть аудиторію"
+                title={current.classroom ? `Корпус ${current.classroom.building.code} · ${current.classroom.number}` : undefined}
+                onPress={() => setPicker('classroom')}
+              />
+            </>
+          ) : null}
+
+          <Label text="Коментар" />
+          <TextInput
+            testID="substitution-comment"
+            value={current.comment}
+            onChangeText={(comment) => update({ comment })}
+            placeholder="Що змінилось (необовʼязково)"
+            placeholderTextColor={colors.textMuted}
+            multiline
+            maxLength={MAX_COMMENT}
+            style={styles.comment}
+            accessibilityLabel="Коментар"
+          />
+
+          {formError ? (
+            <Text style={styles.error} accessibilityRole="alert" testID="substitution-error">
+              {errorText(formError)}
+            </Text>
+          ) : null}
+        </ScrollView>
+
+        <View style={[styles.footer, { paddingBottom: insets.bottom + 16 }]}>
+          <Pressable
+            testID="substitution-submit"
+            accessibilityRole="button"
+            accessibilityState={{ disabled: create.isPending, busy: create.isPending }}
+            disabled={create.isPending}
+            onPress={() => void submit()}
+            style={({ pressed }) => [styles.primary, pressed && styles.primaryPressed]}
+          >
+            {create.isPending ? (
+              <ActivityIndicator color="#FFFFFF" />
+            ) : (
+              <Text style={styles.primaryText}>{groupCode ? `Надіслати групі ${groupCode}` : 'Зберегти заміну'}</Text>
+            )}
+          </Pressable>
+        </View>
+      </View>
+
+      <PickerSheet
+        visible={picker === 'lesson'}
+        testID="lesson-picker"
+        title="Пара"
+        items={lessonItems}
+        selectedKey={lesson?.id}
+        onSelect={(key) => {
+          setTouchedLesson(true);
+          setFormError(null);
+          setForm((f) => ({ ...f, lesson: lessons.find((l) => l.id === key) ?? null }));
+          setPicker(null);
+        }}
+        onClose={() => setPicker(null)}
+        emptyText="Цього тижня немає пар без заміни"
+      />
+      <PickerSheet
+        visible={picker === 'teacher'}
+        testID="teacher-picker"
+        title="Новий викладач"
+        items={teacherItems}
+        selectedKey={current.teacher?.id}
+        search={{ value: teacherQuery, onChange: setTeacherQuery, placeholder: 'Прізвище викладача' }}
+        loading={teachers.isPending}
+        errorCode={teachers.isError ? errorCode(teachers.error) : null}
+        onSelect={(key) => {
+          update({ teacher: teachers.data?.find((t) => t.id === key) ?? null });
+          setPicker(null);
+        }}
+        onClose={() => setPicker(null)}
+      />
+      <PickerSheet
+        visible={picker === 'classroom'}
+        testID="classroom-picker"
+        title="Аудиторія"
+        items={roomItems}
+        selectedKey={current.classroom?.id}
+        search={{ value: roomQuery, onChange: setRoomQuery, placeholder: 'Номер аудиторії' }}
+        loading={classrooms.isPending}
+        errorCode={classrooms.isError ? errorCode(classrooms.error) : null}
+        onSelect={(key) => {
+          update({ classroom: classrooms.data?.find((r) => r.id === key) ?? null });
+          setPicker(null);
+        }}
+        onClose={() => setPicker(null)}
+      />
+    </KeyboardAvoidingView>
+  );
+}
+
+function Header({ onBack }: { onBack: () => void }) {
+  return (
+    <View style={styles.header}>
+      <Pressable testID="substitution-back" accessibilityRole="button" accessibilityLabel="Назад" onPress={onBack} hitSlop={12}>
+        <Ionicons name="chevron-back" size={28} color={colors.primary} />
+      </Pressable>
+      <Text style={styles.title} accessibilityRole="header">
+        Нова заміна
+      </Text>
+    </View>
+  );
+}
+
+const Label = ({ text }: { text: string }) => <Text style={styles.label}>{text.toUpperCase()}</Text>;
+
+function Select({
+  testID,
+  placeholder,
+  title,
+  subtitle,
+  onPress,
+  disabled,
+}: {
+  testID: string;
+  placeholder: string;
+  title?: string;
+  subtitle?: string;
+  onPress: () => void;
+  disabled?: boolean;
+}) {
+  return (
+    <Pressable
+      testID={testID}
+      accessibilityRole="button"
+      accessibilityLabel={title ? [title, subtitle].filter(Boolean).join(', ') : placeholder}
+      accessibilityHint="Відкриває список для вибору"
+      accessibilityState={{ disabled }}
+      disabled={disabled}
+      onPress={onPress}
+      style={({ pressed }) => [styles.select, pressed && styles.selectPressed]}
+    >
+      <View style={styles.selectText}>
+        <Text style={title ? styles.selectTitle : styles.selectPlaceholder}>{title ?? placeholder}</Text>
+        {subtitle ? <Text style={styles.selectSubtitle}>{subtitle}</Text> : null}
+      </View>
+      <Ionicons name="chevron-down" size={20} color={colors.textMuted} />
+    </Pressable>
+  );
+}
+
+function Chip({
+  testID,
+  label,
+  selected,
+  onPress,
+  accessibilityLabel,
+}: {
+  testID: string;
+  label: string;
+  selected: boolean;
+  onPress: () => void;
+  accessibilityLabel?: string;
+}) {
+  return (
+    <Pressable
+      testID={testID}
+      accessibilityRole="button"
+      accessibilityLabel={accessibilityLabel ?? label}
+      accessibilityState={{ selected }}
+      onPress={onPress}
+      style={[styles.chip, selected && styles.chipSelected]}
+    >
+      <Text style={[styles.chipText, selected && styles.chipTextSelected]}>{label}</Text>
+    </Pressable>
+  );
+}
+
+const styles = StyleSheet.create({
+  flex: { flex: 1 },
+  screen: { flex: 1, backgroundColor: colors.background },
+  header: { flexDirection: 'row', alignItems: 'center', gap: 10, paddingHorizontal: 16, paddingBottom: 8 },
+  title: { fontSize: 24, lineHeight: 30, fontWeight: '700', color: colors.text },
+  content: { paddingHorizontal: 21, paddingBottom: 24, gap: 10 },
+  label: { fontSize: 12, lineHeight: 16, fontWeight: '700', color: colors.textSecondary, marginTop: 14, letterSpacing: 0.3 },
+  select: {
+    minHeight: 56,
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: 12,
+    borderRadius: 14,
+    borderWidth: 1,
+    borderColor: colors.border,
+    paddingHorizontal: 14,
+    paddingVertical: 10,
+  },
+  selectPressed: { backgroundColor: colors.chip },
+  selectText: { flex: 1, gap: 2 },
+  selectTitle: { fontSize: 16, lineHeight: 21, fontWeight: '700', color: colors.text },
+  selectPlaceholder: { fontSize: 16, lineHeight: 21, color: colors.textMuted },
+  selectSubtitle: { fontSize: 14, lineHeight: 18, color: colors.textMuted },
+  chips: { flexDirection: 'row', flexWrap: 'wrap', gap: 9 },
+  dayRow: { gap: 9 },
+  chip: {
+    minHeight: 44,
+    justifyContent: 'center',
+    borderRadius: 12,
+    paddingHorizontal: 14,
+    backgroundColor: colors.chip,
+  },
+  chipSelected: { backgroundColor: colors.primary },
+  chipText: { fontSize: 15, lineHeight: 20, fontWeight: '700', color: colors.textSecondary },
+  chipTextSelected: { color: '#FFFFFF' },
+  comment: {
+    minHeight: 100,
+    borderRadius: 14,
+    borderWidth: 1,
+    borderColor: colors.border,
+    paddingHorizontal: 14,
+    paddingTop: 12,
+    paddingBottom: 12,
+    fontSize: 16,
+    lineHeight: 21,
+    color: colors.text,
+    textAlignVertical: 'top',
+  },
+  error: { color: colors.error, fontSize: 15, lineHeight: 20, marginTop: 8 },
+  footer: { paddingHorizontal: 21, paddingTop: 8 },
+  primary: {
+    height: 56,
+    borderRadius: 14,
+    backgroundColor: colors.primary,
+    alignItems: 'center',
+    justifyContent: 'center',
+  },
+  primaryPressed: { backgroundColor: colors.primaryDark },
+  primaryText: { fontSize: 17, fontWeight: '700', color: '#FFFFFF' },
+  savedScreen: { paddingHorizontal: 21 },
+  savedBody: { flex: 1, alignItems: 'center', justifyContent: 'center', gap: 10 },
+  savedIcon: {
+    width: 128,
+    height: 128,
+    borderRadius: 64,
+    backgroundColor: '#DCFCE7',
+    alignItems: 'center',
+    justifyContent: 'center',
+    marginBottom: 18,
+  },
+  savedTitle: { fontSize: 28, lineHeight: 34, fontWeight: '800', color: colors.text, textAlign: 'center' },
+  savedSubtitle: { fontSize: 16, lineHeight: 21, color: colors.textMuted, textAlign: 'center' },
+  secondary: {
+    height: 56,
+    borderRadius: 14,
+    borderWidth: 1,
+    borderColor: colors.border,
+    alignItems: 'center',
+    justifyContent: 'center',
+  },
+  secondaryPressed: { backgroundColor: colors.chip },
+  secondaryText: { fontSize: 17, fontWeight: '700', color: colors.primary },
+});
diff --git a/mobile/src/features/substitutions/form.test.ts b/mobile/src/features/substitutions/form.test.ts
new file mode 100644
index 0000000..bfe79fc
--- /dev/null
+++ b/mobile/src/features/substitutions/form.test.ts
@@ -0,0 +1,111 @@
+import { describe, expect, it } from 'vitest';
+import type { Classroom, Lesson, Teacher } from '../../api';
+import { buildSubstitution, canManageSubstitutions, emptyForm, MAX_COMMENT, selectableLessons } from './form';
+
+const lesson = (over: Partial<Lesson> = {}): Lesson => ({
+  id: 'l1',
+  date: '2026-11-04',
+  pairNumber: 3,
+  start: '11:50',
+  end: '13:10',
+  subject: 'Веб-програмування',
+  type: 'LAB',
+  audience: 'GROUP',
+  subgroup: 0,
+  teacher: 'доц. Горон Б. І.',
+  room: '218/Т',
+  building: null,
+  substitution: null,
+  ...over,
+});
+const teacher: Teacher = { id: 't1', fullName: 'Корчак Ю. М.', position: null };
+const classroom = { id: 'c1', number: 'N10', label: 'N10/Б' } as Classroom;
+const form = (over: Partial<ReturnType<typeof emptyForm>>) => ({ ...emptyForm(lesson()), ...over });
+
+describe('buildSubstitution', () => {
+  it('без пари або типу повертає помилку', () => {
+    expect(buildSubstitution(emptyForm())).toEqual({ ok: false, error: 'LESSON_REQUIRED' });
+    expect(buildSubstitution(form({}))).toEqual({ ok: false, error: 'KIND_REQUIRED' });
+  });
+
+  it('пара, що вже має заміну, відхиляється до відправки', () => {
+    const withSub = lesson({ substitution: { id: 's' } as Lesson['substitution'] });
+    expect(buildSubstitution({ ...emptyForm(withSub), kind: 'CANCELLED' })).toEqual({
+      ok: false,
+      error: 'SUBSTITUTION_EXISTS',
+    });
+  });
+
+  it('скасування: лише пара і тип, коментар обрізається, порожній не відправляється', () => {
+    expect(buildSubstitution(form({ kind: 'CANCELLED', comment: '   ' }))).toEqual({
+      ok: true,
+      body: { lessonId: 'l1', kind: 'CANCELLED' },
+    });
+    expect(buildSubstitution(form({ kind: 'CANCELLED', comment: ' Хворіє ', teacher }))).toEqual({
+      ok: true,
+      body: { lessonId: 'l1', kind: 'CANCELLED', comment: 'Хворіє' },
+    });
+  });
+
+  it('інший викладач потребує викладача, зайву аудиторію не шле', () => {
+    expect(buildSubstitution(form({ kind: 'REPLACED' }))).toEqual({ ok: false, error: 'NEW_TEACHER_REQUIRED' });
+    expect(buildSubstitution(form({ kind: 'REPLACED', teacher, classroom }))).toEqual({
+      ok: true,
+      body: { lessonId: 'l1', kind: 'REPLACED', newTeacherId: 't1' },
+    });
+  });
+
+  it('інша аудиторія потребує аудиторії', () => {
+    expect(buildSubstitution(form({ kind: 'ROOM_CHANGED' }))).toEqual({ ok: false, error: 'NEW_CLASSROOM_REQUIRED' });
+    expect(buildSubstitution(form({ kind: 'ROOM_CHANGED', classroom, teacher }))).toEqual({
+      ok: true,
+      body: { lessonId: 'l1', kind: 'ROOM_CHANGED', newClassroomId: 'c1' },
+    });
+  });
+
+  it('перенесення: потрібні нова дата або пара, і хоч щось має відрізнятися', () => {
+    expect(buildSubstitution(form({ kind: 'MOVED' }))).toEqual({ ok: false, error: 'NEW_DATE_OR_PAIR_REQUIRED' });
+    expect(buildSubstitution(form({ kind: 'MOVED', newDate: '2026-11-04', newPairNumber: 3 }))).toEqual({
+      ok: false,
+      error: 'MOVE_TARGET_SAME_AS_ORIGINAL',
+    });
+    expect(buildSubstitution(form({ kind: 'MOVED', newPairNumber: 5 }))).toEqual({
+      ok: true,
+      body: { lessonId: 'l1', kind: 'MOVED', newPairNumber: 5 },
+    });
+    expect(buildSubstitution(form({ kind: 'MOVED', newDate: '2026-11-06', classroom, teacher }))).toEqual({
+      ok: true,
+      body: { lessonId: 'l1', kind: 'MOVED', newDate: '2026-11-06', newClassroomId: 'c1' },
+    });
