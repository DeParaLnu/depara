+import { describe, expect, it } from 'vitest';
+import { PERSIST_MAX_AGE_MS, shouldPersistQuery } from './queryPersistPolicy';
+
+const q = (key: unknown[], status = 'success') => ({ queryKey: key, state: { status } });
+
+describe('shouldPersistQuery', () => {
+  it.each([['week'], ['me'], ['groups'], ['buildings']])('зберігає успішний запит %s', (name) => {
+    expect(shouldPersistQuery(q([name, '2026-11-02']))).toBe(true);
+  });
+
+  it('не зберігає пошук аудиторій та невідомі запити', () => {
+    expect(shouldPersistQuery(q(['classrooms', 'N1', '']))).toBe(false);
+    expect(shouldPersistQuery(q(['щось']))).toBe(false);
+  });
+
+  it('не зберігає запити без успіху (помилка, завантаження)', () => {
+    expect(shouldPersistQuery(q(['week', 'd'], 'error'))).toBe(false);
+    expect(shouldPersistQuery(q(['week', 'd'], 'pending'))).toBe(false);
+  });
+
+  it('строк збереження 14 днів', () => {
+    expect(PERSIST_MAX_AGE_MS).toBe(14 * 24 * 3600 * 1000);
+  });
+});
diff --git a/mobile/src/lib/queryPersistPolicy.ts b/mobile/src/lib/queryPersistPolicy.ts
new file mode 100644
index 0000000..63ded54
--- /dev/null
+++ b/mobile/src/lib/queryPersistPolicy.ts
@@ -0,0 +1,16 @@
+// Що з кешу запитів переживає перезапуск застосунку. Чиста логіка без нативних модулів: її перевіряють юніт-тести,
+// а саме сховище (AsyncStorage) підключено в queryPersist.ts.
+
+/** Скільки зберігаємо кеш на диску. Розклад старший за цей строк уже не показуємо як «збережений». */
+export const PERSIST_MAX_AGE_MS = 14 * 24 * 60 * 60 * 1000;
+
+/** Змінюйте при зміні форми відповідей API: старий кеш на диску тоді відкидається, а не ламає екрани. */
+export const PERSIST_CACHE_VERSION = '1';
+
+// Лише те, що потрібно, щоб відкрити розклад без мережі. Пошук аудиторій навмисно не зберігаємо.
+const PERSISTED_KEYS = new Set(['week', 'me', 'groups', 'buildings']);
+
+type QueryLike = { queryKey: readonly unknown[]; state: { status: string } };
+
+export const shouldPersistQuery = (query: QueryLike): boolean =>
+  query.state.status === 'success' && PERSISTED_KEYS.has(String(query.queryKey[0]));
