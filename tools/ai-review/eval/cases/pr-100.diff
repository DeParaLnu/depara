diff --git a/mobile/src/features/push/SubstitutionPushSetting.tsx b/mobile/src/features/push/SubstitutionPushSetting.tsx
new file mode 100644
index 0000000..a63d496
--- /dev/null
+++ b/mobile/src/features/push/SubstitutionPushSetting.tsx
@@ -0,0 +1,103 @@
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { useEffect, useState } from 'react';
+import { AppState, Linking, Pressable, StyleSheet, Switch, Text, View } from 'react-native';
+import { api, type Me } from '../../api';
+import { colors } from '../../theme';
+import { useSession } from '../auth/session';
+import { hasPermission, notificationsSupported, requestPermission } from '../reminders/notifications';
+import { useMe } from '../schedule/hooks';
+import { syncPushToken } from './registration';
+
+// F8/F9: перемикач «Зміни та скасування». Налаштування живе на сервері: саме він вирішує, кому слати пуш.
+// Вимкнений перемикач токен пристрою не прибирає, сервер просто не шле цьому користувачу.
+export function SubstitutionPushSetting() {
+  const token = useSession((s) => s.session?.accessToken);
+  const queryClient = useQueryClient();
+  const me = useMe();
+  // Старі відповіді без поля вважаємо ввімкненими, як і значення за замовчуванням на сервері
+  const enabled = me.data?.notifySubstitutions ?? true;
+
+  const save = useMutation({
+    mutationKey: ['updateSettings'],
+    mutationFn: (notifySubstitutions: boolean) => api.updateSettings(token!, { notifySubstitutions }),
+    // Перемикач реагує одразу, а при збої повертається назад
+    onMutate: async (notifySubstitutions) => {
+      await queryClient.cancelQueries({ queryKey: ['me'] });
+      const previous = queryClient.getQueryData<Me>(['me']);
+      if (previous) queryClient.setQueryData<Me>(['me'], { ...previous, notifySubstitutions });
+      return { previous };
+    },
+    onError: (_error, _value, context) => {
+      if (context?.previous) queryClient.setQueryData(['me'], context.previous);
+    },
+    onSuccess: (updated: Me) => queryClient.setQueryData(['me'], updated),
+  });
+
+  const [missingPermission, setMissingPermission] = useState(false);
+  const [denied, setDenied] = useState(false);
+
+  useEffect(() => {
+    if (!notificationsSupported) return;
+    const check = () => {
+      void hasPermission().then((granted) => {
+        setMissingPermission(!granted);
+        if (granted) setDenied(false);
+      });
+    };
+    check();
+    // Користувач міг увімкнути сповіщення в налаштуваннях телефону і повернутися
+    const sub = AppState.addEventListener('change', (s) => s === 'active' && check());
+    return () => sub.remove();
+  }, []);
+
+  const allow = async () => {
+    const result = await requestPermission();
+    if (result === 'granted') {
+      setMissingPermission(false);
+      if (token) void syncPushToken(token);
+    } else {
+      setDenied(true);
+    }
+  };
+
+  return (
+    <View style={styles.block}>
+      <View style={styles.row}>
+        <Text style={styles.label}>Зміни та скасування</Text>
+        <Switch
+          testID="notify-substitutions"
+          accessibilityLabel="Зміни та скасування"
+          value={enabled}
+          disabled={!me.data || save.isPending}
+          onValueChange={(value) => save.mutate(value)}
+          trackColor={{ true: colors.primary, false: colors.border }}
+        />
+      </View>
+      {save.isError ? <Text style={styles.hint}>Не вдалося зберегти. Перевірте звʼязок і спробуйте ще раз.</Text> : null}
+      {enabled && denied ? (
+        <View style={styles.hintRow} accessibilityRole="alert">
+          <Text style={styles.hint}>Сповіщення вимкнені для ДеПари. Увімкніть їх у налаштуваннях телефону.</Text>
+          <Pressable testID="push-open-settings" accessibilityRole="link" onPress={() => void Linking.openSettings()} hitSlop={8}>
+            <Text style={styles.link}>Відкрити налаштування</Text>
+          </Pressable>
+        </View>
+      ) : enabled && missingPermission ? (
+        <View style={styles.hintRow} accessibilityRole="alert">
+          <Text style={styles.hint}>Без дозволу на сповіщення повідомлення про заміни не прийдуть.</Text>
+          <Pressable testID="push-allow" accessibilityRole="button" onPress={() => void allow()} hitSlop={8}>
+            <Text style={styles.link}>Дозволити</Text>
+          </Pressable>
+        </View>
+      ) : null}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  block: { gap: 4 },
+  row: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', minHeight: 44 },
+  label: { fontSize: 17, color: colors.text, flexShrink: 1 },
+  hintRow: { gap: 4 },
+  hint: { fontSize: 14, lineHeight: 19, color: colors.textMuted },
+  link: { fontSize: 14, fontWeight: '700', color: colors.primary, textDecorationLine: 'underline' },
+});
diff --git a/mobile/src/features/push/registration.test.ts b/mobile/src/features/push/registration.test.ts
new file mode 100644
index 0000000..053492d
--- /dev/null
+++ b/mobile/src/features/push/registration.test.ts
@@ -0,0 +1,104 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const { registerPushToken, removePushToken, hasPermission, readPushToken } = vi.hoisted(() => ({
+  registerPushToken: vi.fn(),
+  removePushToken: vi.fn(),
+  hasPermission: vi.fn(),
+  readPushToken: vi.fn(),
+}));
+
+vi.mock('../../api', () => ({ api: { registerPushToken, removePushToken } }));
+vi.mock('../../lib/logger', () => ({ log: { warn: vi.fn() } }));
+vi.mock('../reminders/notifications', () => ({ hasPermission }));
+vi.mock('./token', () => ({ readPushToken }));
+
+import { syncPushToken, unregisterPushToken } from './registration';
+
+const TOKEN = 'ExponentPushToken[abc]';
+
+beforeEach(async () => {
+  // Модуль памʼятає токен: кожен тест починає з виходу, потім чисті лічильники
+  readPushToken.mockResolvedValue(null);
+  await unregisterPushToken('tok');
+  vi.clearAllMocks();
+  hasPermission.mockResolvedValue(true);
+  readPushToken.mockResolvedValue(TOKEN);
+  registerPushToken.mockResolvedValue(undefined);
+  removePushToken.mockResolvedValue(undefined);
+});
+
+describe('syncPushToken', () => {
+  it('шле токен, коли є дозвіл', async () => {
+    await syncPushToken('tok');
+    expect(registerPushToken).toHaveBeenCalledWith('tok', TOKEN);
+  });
+
+  it('без дозволу не запитує токен і нічого не шле', async () => {
+    hasPermission.mockResolvedValue(false);
+    await syncPushToken('tok');
+    expect(readPushToken).not.toHaveBeenCalled();
+    expect(registerPushToken).not.toHaveBeenCalled();
+  });
+
+  it('без токена (Expo Go, немає projectId) нічого не шле', async () => {
+    readPushToken.mockResolvedValue(null);
+    await syncPushToken('tok');
+    expect(registerPushToken).not.toHaveBeenCalled();
+  });
+
+  it('той самий токен шле один раз, новий шле знову', async () => {
+    await syncPushToken('tok');
+    await syncPushToken('tok');
+    expect(registerPushToken).toHaveBeenCalledTimes(1);
+    readPushToken.mockResolvedValue('ExponentPushToken[new]');
+    await syncPushToken('tok');
+    expect(registerPushToken).toHaveBeenLastCalledWith('tok', 'ExponentPushToken[new]');
+  });
+
+  it('після збою сервера пробує знову і не кидає помилку', async () => {
+    registerPushToken.mockRejectedValueOnce(new Error('NETWORK_ERROR'));
+    await expect(syncPushToken('tok')).resolves.toBeUndefined();
+    await syncPushToken('tok');
+    expect(registerPushToken).toHaveBeenCalledTimes(2);
+  });
+
+  it('одночасні виклики роблять один запит', async () => {
+    await Promise.all([syncPushToken('tok'), syncPushToken('tok')]);
+    expect(registerPushToken).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe('unregisterPushToken', () => {
+  it('видаляє зареєстрований токен', async () => {
+    await syncPushToken('tok');
+    readPushToken.mockClear();
+    await unregisterPushToken('tok');
+    expect(removePushToken).toHaveBeenCalledWith('tok', TOKEN);
+    expect(readPushToken).not.toHaveBeenCalled();
+  });
+
+  it('токен із минулого запуску теж видаляє', async () => {
+    await unregisterPushToken('tok');
+    expect(removePushToken).toHaveBeenCalledWith('tok', TOKEN);
+  });
+
+  it('вихід під час реєстрації не дає токену дійти до сервера', async () => {
+    let release!: (value: string) => void;
+    readPushToken.mockReturnValueOnce(new Promise<string>((resolve) => (release = resolve)));
+    const sync = syncPushToken('tok');
+    await Promise.resolve();
+    const out = unregisterPushToken('tok');
+    release(TOKEN);
+    await Promise.all([sync, out]);
+    expect(registerPushToken).not.toHaveBeenCalled();
+    expect(removePushToken).toHaveBeenCalledWith('tok', TOKEN);
+  });
+
+  it('збій сервера не ламає вихід, а наступний вхід реєструє токен знову', async () => {
+    await syncPushToken('tok');
+    removePushToken.mockRejectedValueOnce(new Error('NETWORK_ERROR'));
+    await expect(unregisterPushToken('tok')).resolves.toBeUndefined();
+    await syncPushToken('tok2');
+    expect(registerPushToken).toHaveBeenLastCalledWith('tok2', TOKEN);
+  });
+});
